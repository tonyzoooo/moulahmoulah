# Stripe test-mode secret key — https://dashboard.stripe.com/test/apikeys
# Never commit a live (sk_live_) key.
STRIPE_SECRET_KEY=sk_test_xxx

# Public base URL of the frontend, used to build Stripe success/cancel URLs.
# Dev (Vite on :5173):            http://localhost:5173
# Production (single binary :3000): http://localhost:3000
BASE_URL=http://localhost:5173
